NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_PRO=price_...           # $4.99/mo subscription
STRIPE_PRICE_SKIN_WOOD=price_...     # $2.99 one-time
STRIPE_PRICE_SKIN_MIDNIGHT=price_... # $2.99 one-time
STRIPE_PRICE_SKIN_NEON=price_...     # $2.99 one-time

# Stripe Product IDs (used in lib/skins.ts)
STRIPE_PRODUCT_SKIN_WOOD=prod_...
STRIPE_PRODUCT_SKIN_MIDNIGHT=prod_...
STRIPE_PRODUCT_SKIN_NEON=prod_...

# App URL (for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
